# Copy to .env (git-ignored). dbmate reads DATABASE_URL from .env automatically.

# Local docker-compose database
DATABASE_URL=postgres://postgres:postgres@localhost:55432/isaas_dev?sslmode=disable

# Throwaway database for ./scripts/test.sh (dropped and recreated on every run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/isaas_test?sslmode=disable

# The schema dump needs pg_dump >= the server version; skip it by default.
DBMATE_NO_DUMP_SCHEMA=true

# Neon branch (use the DIRECT endpoint, not "-pooler", for migrations):
# DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
